# Hugging Face Access Token (Required for gated bodhan-ai/indic-speak)
HF_TOKEN=hf_your_approved_token_here

# Cache and Hardware Settings
HF_HOME=/workspace/hf_cache
HF_HUB_ENABLE_HF_TRANSFER=1
INDIC_SPEAK_MODEL=bodhan-ai/indic-speak
DEVICE=cuda
MAX_CONCURRENT_SYNTH=4
STREAM_CHUNK_FRAMES=4
PORT=8000
HOST=0.0.0.0
